# RepoTrace backend
REPO_TRACE_ENV=development
REPO_TRACE_DB_PATH=./var/repotrace.db
REPO_TRACE_CORS_ORIGINS=http://localhost:5173

# GitHub. Public repositories can work without a token, but rate limits are much lower.
REPO_TRACE_GITHUB_TOKEN=
REPO_TRACE_GITHUB_MAX_ISSUES=120
REPO_TRACE_GITHUB_MAX_PULLS=80
REPO_TRACE_GITHUB_MAX_COMMITS=120
REPO_TRACE_GITHUB_MAX_DOCS=40

# LLM: OpenAI-compatible endpoint.
REPO_TRACE_LLM_ENABLED=false
REPO_TRACE_LLM_BASE_URL=https://opencode.ai/zen/go/v1
REPO_TRACE_LLM_API_KEY=
REPO_TRACE_LLM_MODEL=deepseek-v4-flash
# RepoTrace will retry once without this field if the provider rejects it.
REPO_TRACE_LLM_REASONING_EFFORT=max
REPO_TRACE_LLM_TIMEOUT_SECONDS=90

# Retrieval
REPO_TRACE_RETRIEVAL_TOP_K=12
REPO_TRACE_RERANK_TOP_K=6

# Optional Langfuse export. RepoTrace always keeps a local trace even when this is disabled.
REPO_TRACE_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
